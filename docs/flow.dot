// The SDD flow, laid out on a fixed grid: backbone (run in order), utilities (call anytime), close the loop.
// Render: neato -n2 -Tsvg docs/flow.dot -o docs/flow-grid.svg
digraph sdd {
  pad=0.35; bgcolor="white"; splines=true; fontname="Helvetica";
  node [shape=box, style=filled, fillcolor="white", penwidth=1.5, margin="0.03,0.02", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=15, fontcolor="#6b7685", color="#9aa5b5", penwidth=1.8, arrowsize=0.8];
  title [shape=plaintext, style="", pos="330,880!", label=<<FONT POINT-SIZE="42" COLOR="#1b2430"><B>SDD</B></FONT>  <FONT POINT-SIZE="23" COLOR="#6b7685">Spec-driven development: one idea, walked to shipped code</FONT>>];
  bg_start [shape=box, style="rounded,filled", fillcolor="#f5f2ff", color="#f5f2ff", penwidth=0, fixedsize=true, width=23.611, height=2.028, labelloc=t, label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><FONT COLOR="#7a5af8" POINT-SIZE="20"><B>START · ONCE PER IDEA OR REPO</B></FONT></TD></TR></TABLE>>, pos="870.0,753.0!"];
  bg_back [shape=box, style="rounded,filled", fillcolor="#eef3ff", color="#eef3ff", penwidth=0, fixedsize=true, width=23.611, height=4.222, labelloc=t, label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><FONT COLOR="#2f5fd0" POINT-SIZE="20"><B>BACKBONE · RUN IN ORDER</B></FONT></TD></TR></TABLE>>, pos="870.0,516.0!"];
  bg_back2 [shape=box, style="rounded,filled", fillcolor="#eef3ff", color="#eef3ff", penwidth=0, fixedsize=true, width=4.722, height=1.667, labelloc=t, label="", pos="190.0,266.0!"];
  bg_close [shape=box, style="rounded,filled", fillcolor="#eefaf2", color="#eefaf2", penwidth=0, fixedsize=true, width=14.167, height=2.028, labelloc=t, label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><FONT COLOR="#1f9d55" POINT-SIZE="20"><B>CLOSE THE LOOP · AFTER THE CODE</B></FONT></TD></TR></TABLE>>, pos="870.0,279.0!"];
  bg_util [shape=box, style="rounded,filled", fillcolor="#fff8ea", color="#fff8ea", penwidth=0, fixedsize=true, width=23.611, height=2.028, labelloc=t, label=<<TABLE BORDER="0" CELLPADDING="6"><TR><TD ALIGN="LEFT"><FONT COLOR="#c97a00" POINT-SIZE="20"><B>UTILITIES · CALL ANYTIME</B></FONT></TD></TR></TABLE>>, pos="870.0,121.0!"];
  interview [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>A</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🎤 interview</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">optional · pressure-test the idea</FONT></TD></TR></TABLE>>, color="#ddd5ff", pos="190,740!"];
  survey [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>B</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🗺️ survey</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">once per repo · map the code</FONT></TD></TR></TABLE>>, color="#ddd5ff", pos="530,740!"];
  roadmap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>C</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🧭 roadmap</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">optional · steps and waves</FONT></TD></TR></TABLE>>, color="#ddd5ff", pos="870,740!"];
  scaffold [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>D</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🏗️ scaffold</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">greenfield · skeleton first</FONT></TD></TR></TABLE>>, color="#ddd5ff", pos="1210,740!"];
  designsys [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>UI</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🎨 design-system</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">once per repo · UI only</FONT></TD></TR></TABLE>>, color="#ddd5ff", pos="1550,740!"];
  specify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>1</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>📝 specify</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">interview to spec + criteria</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="190,582!"];
  clarify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>2</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>❓ clarify</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">close ambiguities</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="530,582!"];
  uxflows [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>3</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🧑‍💻 ux-flows</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">UI only · user flows</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="870,582!"];
  design [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>4</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>📐 design</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">architecture, C4, ADRs</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="1210,582!"];
  sequences [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>5</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🔀 sequences</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">runtime sequence diagrams</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="1550,582!"];
  datamodel [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>6</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🗄️ data-model</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">entities, migrations</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="1550,424!"];
  api [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>7</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🔌 api</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">OpenAPI and events</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="1210,424!"];
  screens [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>8</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🖼️ screens</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">UI only · every state</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="870,424!"];
  tasks [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>9</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>✅ tasks</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">atomic tasks, dependency DAG</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="530,424!"];
  plantests [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>10</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🧪 plan-tests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">criterion → test mapping</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="190,424!"];
  implement [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>11</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>⚙️ implement</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">TDD: fail, pass, gate, commit</FONT></TD></TR></TABLE>>, color="#c9d8fb", pos="190,266!"];
  review [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#1f9d55" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>12</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🔍 review</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">independent · can loop back</FONT></TD></TR></TABLE>>, color="#bfe6cc", pos="530,266!"];
  ship [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#1f9d55" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>13</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B>🚀 ship</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">verify it runs · changelog · PR</FONT></TD></TR></TABLE>>, color="#bfe6cc", pos="870,266!"];
  done [label=<<FONT COLOR="white" POINT-SIZE="23"><B>🎉 Shipped: PR + changelog</B></FONT>>, fillcolor="#1f9d55", color="#1f9d55", style="filled,rounded", margin="0.22,0.14", pos="1210,266!"];
  config [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>⚙️</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B> config</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">project settings file</FONT></TD></TR></TABLE>>, color="#f3dba6", pos="190,108!"];
  classifysize [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>📏</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B> classify-size</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">size the feature XS to XL</FONT></TD></TR></TABLE>>, color="#f3dba6", pos="530,108!"];
  glossary [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>📖</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B> glossary</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">capture a domain term</FONT></TD></TR></TABLE>>, color="#f3dba6", pos="870,108!"];
  decideadr [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>⚖️</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B> decide-adr</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">record a decision later</FONT></TD></TR></TABLE>>, color="#f3dba6", pos="1210,108!"];
  fix [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="50"><FONT COLOR="white" POINT-SIZE="22"><B>🔧</B></FONT></TD><TD ALIGN="LEFT" WIDTH="250"><FONT POINT-SIZE="24" COLOR="#1b2430"><B> fix</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16" COLOR="#6b7685">reproduce, test, patch</FONT></TD></TR></TABLE>>, color="#f3dba6", pos="1550,108!"];
  interview -> survey;
  survey -> roadmap;
  roadmap -> scaffold [style=dashed];
  designsys -> uxflows [style=dashed];
  roadmap:s -> specify:n;
  specify -> clarify -> uxflows -> design -> sequences [color="#2f5fd0", penwidth=2.4];
  sequences -> datamodel -> api -> screens -> tasks -> plantests -> implement [color="#2f5fd0", penwidth=2.4];
  implement -> review -> ship -> done [color="#1f9d55", penwidth=2.4];
  review -> implement [style=dashed, color="#1f9d55", constraint=false];
}
