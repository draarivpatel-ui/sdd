// The SDD flow: backbone (run in order), utilities (call anytime), close the loop.
// Generated layout, edit freely. Render: dot -Tsvg docs/flow.dot -o docs/flow.svg
digraph sdd {
  rankdir=TB; newrank=true; pad=0.5; nodesep=0.5; ranksep=0.42; bgcolor="white";
  fontname="Helvetica";
  label=<<FONT POINT-SIZE="44" COLOR="#1b2430"><B>SDD</B></FONT><BR/><FONT POINT-SIZE="24" COLOR="#6b7685">Spec-driven development: one idea, walked to shipped code</FONT><BR/> >;
  labelloc=t;
  node [shape=box, style=filled, fillcolor="white", penwidth=1.5, margin="0.04,0.02", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=17, fontcolor="#6b7685", color="#9aa5b5", penwidth=1.8, arrowsize=0.8];

  subgraph cluster_start {
    label=<<FONT COLOR="#7a5af8" POINT-SIZE="21"><B>START · ONCE PER IDEA OR REPO</B></FONT>>; labeljust=l;
    style="rounded,filled"; fillcolor="#f5f2ff"; color="#ddd5ff"; penwidth=1.5; margin=22;
    interview [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>A</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🎤 interview</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">optional · pressure-test the idea</FONT></TD></TR></TABLE>>, color="#ddd5ff"];
    survey [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>B</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🗺️ survey</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">once per repo · map the architecture</FONT></TD></TR></TABLE>>, color="#ddd5ff"];
    roadmap [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>C</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🧭 roadmap</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">optional · split into steps and waves</FONT></TD></TR></TABLE>>, color="#ddd5ff"];
    interview -> survey [label="  idea-brief.md"];
    survey -> roadmap [label="  architecture-map.md"];
  }
  scaffold [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>D</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🏗️ scaffold</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">greenfield only · skeleton as step 1</FONT></TD></TR></TABLE>>, color="#ddd5ff"];
  designsys [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#7a5af8" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>UI</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🎨 design-system</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">once per repo · UI features</FONT></TD></TR></TABLE>>, color="#ddd5ff"];
  subgraph cluster_back {
    label=<<FONT COLOR="#2f5fd0" POINT-SIZE="21"><B>BACKBONE · RUN IN ORDER</B></FONT>>; labeljust=l;
    style="rounded,filled"; fillcolor="#eef3ff"; color="#c9d8fb"; penwidth=1.5; margin=22;
    specify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>1</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>📝 specify</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">interview to spec, with acceptance criteria</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    clarify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>2</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>❓ clarify</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">close ambiguities before design</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    uxflows [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>3</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🧑‍💻 ux-flows</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">UI only · user flows and screen list</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    design [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>4</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>📐 design</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">architecture, C4, ADRs</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    sequences [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>5</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🔀 sequences</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">runtime flows as sequence diagrams</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    datamodel [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>6</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🗄️ data-model</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">entities and migrations</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    api [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>7</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🔌 api</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">OpenAPI and events</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    screens [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>8</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🖼️ screens</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">UI only · every screen in every state</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    tasks [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>9</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>✅ tasks</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">atomic tasks and a dependency DAG</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    plantests [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>10</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🧪 plan-tests</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">every criterion mapped to a test</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    implement [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#2f5fd0" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>11</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>⚙️ implement</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">TDD engine · failing test, pass, gate, commit</FONT></TD></TR></TABLE>>, color="#c9d8fb"];
    specify -> clarify -> uxflows -> design -> sequences -> datamodel -> api -> screens -> tasks -> plantests -> implement [color="#2f5fd0", penwidth=2.4];
  }
  subgraph cluster_close {
    label=<<FONT COLOR="#1f9d55" POINT-SIZE="21"><B>CLOSE THE LOOP · AFTER THE CODE IS WRITTEN</B></FONT>>; labeljust=l;
    style="rounded,filled"; fillcolor="#eefaf2"; color="#bfe6cc"; penwidth=1.5; margin=22;
    review [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#1f9d55" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>12</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🔍 review</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">independent, clean-context review</FONT></TD></TR></TABLE>>, color="#bfe6cc"];
    ship [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#1f9d55" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>13</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🚀 ship</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">verify it runs · changelog · PR</FONT></TD></TR></TABLE>>, color="#bfe6cc"];
  }
  done [label=<<FONT COLOR="white" POINT-SIZE="25"><B>🎉  Shipped: PR + changelog</B></FONT>>, fillcolor="#1f9d55", color="#1f9d55", margin="0.3,0.16", style="filled,rounded"];
  subgraph cluster_util {
    label=<<FONT COLOR="#c97a00" POINT-SIZE="21"><B>UTILITIES · CALL ANYTIME</B></FONT>>; labeljust=l;
    style="rounded,filled"; fillcolor="#fff8ea"; color="#f3dba6"; penwidth=1.5; margin=22;
    config [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>·</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>⚙️ config</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">per-project settings file</FONT></TD></TR></TABLE>>, color="#f3dba6"];
    classifysize [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>·</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>📏 classify-size</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">size the feature XS to XL</FONT></TD></TR></TABLE>>, color="#f3dba6"];
    glossary [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>·</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>📖 glossary</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">capture a domain term</FONT></TD></TR></TABLE>>, color="#f3dba6"];
    decideadr [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>·</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>⚖️ decide-adr</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">record a decision after the fact</FONT></TD></TR></TABLE>>, color="#f3dba6"];
    fix [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#c97a00" ROWSPAN="2" WIDTH="46"><FONT COLOR="white" POINT-SIZE="22"><B>·</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"> </TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="25" COLOR="#1b2430"><B>🔧 fix</B></FONT></TD></TR><TR><TD></TD><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="17" COLOR="#6b7685">reproduce, pin with a test, patch</FONT></TD></TR></TABLE>>, color="#f3dba6"];
    config -> classifysize -> glossary -> decideadr -> fix [style=invis];
  }

  roadmap -> scaffold [style=dashed];
  roadmap -> specify  [label="  per step"];
  scaffold -> specify;
  designsys -> uxflows [style=dashed];
  implement -> review -> ship -> done [color="#1f9d55", penwidth=2.4];
  review -> implement [style=dashed, color="#1f9d55", constraint=false, label="  loop back"];
  { rank=same; specify; config; }
}
