// The SDD flow: backbone (run in order), utilities (call anytime), close the loop.
// Render: dot -Tsvg docs/flow.dot -o docs/flow.svg
digraph sdd {
  rankdir=TB;
  nodesep=0.4; ranksep=0.45; newrank=true;
  fontname="Helvetica"; fontsize=26;
  node [shape=box, style="rounded,filled", fillcolor="#ffffff", fontname="Helvetica", fontsize=24, margin="0.35,0.15"];
  edge [fontname="Helvetica", fontsize=20, penwidth=1.6];

  // entry: once per idea / repo
  subgraph cluster_entry {
    label="START: once per idea or repo"; labeljust=l;
    style="rounded,filled"; fillcolor="#f3f0ff"; color="#8b7bd0";
    interview [label="interview (optional)"];
    survey    [label="survey"];
    roadmap   [label="roadmap (optional)"];
    interview -> survey [label="  idea-brief.md"];
    survey -> roadmap   [label="  architecture-map.md"];
  }
  scaffold [label="scaffold (greenfield)"];
  roadmap -> scaffold [style=dashed];
  roadmap -> specify  [label="  per step"];
  scaffold -> specify;

  // backbone: one straight line
  subgraph cluster_backbone {
    label="BACKBONE: run in order"; labeljust=l;
    style="rounded,filled"; fillcolor="#eef4ff"; color="#6b8cce";
    specify; clarify;
    uxflows [label="ux-flows (UI only)"];
    design; sequences; datamodel [label="data-model"]; api;
    screens [label="screens (UI only)"];
    tasks; plantests [label="plan-tests"]; implement;
    specify -> clarify -> uxflows -> design -> sequences -> datamodel -> api -> screens -> tasks -> plantests -> implement;
  }

  // close the loop
  subgraph cluster_close {
    label="CLOSE THE LOOP: after the code is written"; labeljust=l;
    style="rounded,filled"; fillcolor="#effaf0"; color="#6bb27a";
    review; ship;
  }
  implement -> review -> ship;
  review -> implement [style=dotted, constraint=false, label="  loop back"];
  done [label="shipped: PR + changelog", shape=box, style="rounded,filled", fillcolor="#d8f3dc"];
  ship -> done;

  // utilities: call anytime, beside the backbone
  subgraph cluster_util {
    label="UTILITIES: call anytime"; labeljust=l;
    style="rounded,filled"; fillcolor="#fff7e6"; color="#d9a441";
    config; classifysize [label="classify-size"]; glossary; decideadr [label="decide-adr"]; fix;
    config -> classifysize -> glossary -> decideadr -> fix [style=invis];
  }
  designsys [label="design-system\n(UI, once per repo)"];
  designsys -> uxflows [style=dashed];
  { rank=same; specify; config; }
}
